@model Test.Models.Expense

@{
    ViewData["Title"] = "Add New Expense";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card glass-card p-4 shadow-lg">
        <div class="mb-4">
            <h3 class="fw-bold text-white mb-1"> Record A New Expense</h3>
            <p class="text-muted small">Enter the amount of money you make.</p>
        </div>
    </div>
</div>
<form asp-controller="Expense" asp-action="Create" method="post">
    <div class="form-group mb-4">
        <label asp-for="Title" class="form-label text-secondary fw-medium">What did you buy?</label>
        <input asp-for="Title" class="form-control px-3 py-2" placeholder="Groceries, Flix subscription" style="background: rgba(15, 23, 42, 0.3); border: 1px solid var(--card-border); color: var(--text-main);" />
        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
        
            <div class="d-flex gap-2 justify-content-end mt-4">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4 py-2 fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-sm btn-primary px-4 py-2 fw-semibold" style="background: linear-gradient(135deg, #38df8 0%, #0284c7 100%); border: none;">
                     Save Transaction
                 </button>
            </div>
    </div>
</form>